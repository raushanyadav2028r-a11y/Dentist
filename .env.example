# ==============================================================================
# ENVIRONMENT CONFIGURATION EXAMPLE (.env.local)
# ==============================================================================
# In variables ko apni .env.local file me copy karein

# Supabase (Database & Admin Panel - Optional for static config mode)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional Email Alerts on New Booking (Resend.com)
# Agar ye khali hoga to bhi booking form WhatsApp flow se 100% chalega
RESEND_API_KEY=

# Optional Google Maps API Key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
